[node name="InstructionsLabel" type="Label" parent="UI/HowToPlayPanel/Panel/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.88, 0.92, 1, 1)
theme_override_font_sizes/font_size = 22
text = "1. Tap PLAY to start a level.

2. Use ◀ and ▶ (bottom-left) to move your ship left and right.

3. Hold the shoot button (bottom-right) to fire at enemies.

4. Destroy every enemy in the level to complete it and earn coins.

5. Don't let enemies reach the bottom of the screen — you lose a life.

6. Collect power-ups for extra life, faster bullets, or double shoot.

7. Defeat bosses for big coin bonuses on special levels.

8. Spend coins to continue after game over, or visit the Shop for upgrades.

9. Enable the joystick in Settings if you prefer drag-to-move controls."
autowrap_mode = 3

